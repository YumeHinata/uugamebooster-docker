#!/bin/sh /etc/rc.common

START=51

start() {
    if [ "$(uci get nfnlq_userland.antiy.version)" != "1" ]; then
        ubus call uci add '{
            "config": "nfnlq_userland",
            "type": "extension",
            "name": "antiy"
        }'
        ubus call uci set '{
            "config": "nfnlq_userland",
            "section": "antiy",
            "values": {
                "version": "1",
                "path": "\/usr\/lib\/libdpi_antiy.so",
                "pre_targets": [
                    "IF",
                    "-m miwifi-connantiy --check-url",
                    "AND",
                    "-p tcp",
                    "AND",
                    "NOT -m conntrack --ctstate ESTABLISHED --ctstatus ASSURED",
                    "THEN",
                    "-j MARK --set-mark 0x20\/0x20",
                    "FI"
                ],
                "matches": [
                    "-m miwifi-connantiy --check-url",
                    "AND",
                    "(",
                    "! -p tcp",
                    "OR",
                    "-m conntrack --ctstate ESTABLISHED --ctstatus ASSURED",
                    ")"
                ]
            }
        }'
        ubus call uci commit '{"config": "nfnlq_userland"}'
        echo "flushed antiy nfnlq configurations"
    fi
}