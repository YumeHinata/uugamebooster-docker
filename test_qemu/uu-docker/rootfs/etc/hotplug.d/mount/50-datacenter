logger -p notice -t "hotplug.d" "block-50-datacenter: run because of $DEVICE $ACTION"

[ -n "$DEVICE" ] || exit 2
[ -n "$MOUNTPATH" ] || exit 3

case "$ACTION" in
    add)
        logger -p notice -t "hotplug.d" "block-50-datacenter: mount:$MOUNTPATH, dev:$DEVICE"
        /usr/sbin/datacenterClient -h 0.0.0.0 -p 9090 -i "{\"api\": 63, \"path\": \""$MOUNTPATH"\", \"dev\": \""$DEVICE"\", \"status\": 1}"
        ;;
    remove)
        logger -p notice -t "hotplug.d" "block-50-datacenter: mount:$MOUNTPATH, dev:$DEVICE"
        /usr/sbin/datacenterClient -h 0.0.0.0 -p 9090 -i "{\"api\": 63, \"path\": \""$MOUNTPATH"\", \"dev\": \""$DEVICE"\", \"status\": 0}"
        ;;
esac

exit 0