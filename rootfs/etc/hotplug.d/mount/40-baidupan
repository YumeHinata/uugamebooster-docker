logger -p notice -t "hotplug.d" "40-baidupan: run because of $DEVICE $ACTION"

[ "$ACTION" == "add" -o "$ACTION" == "remove" ] || exit 1
[ -n "$DEVICE" ] || exit 2

#uuid="$(uci -q get baidupan.user.uuid)"

case "$ACTION" in
add)
    #if storage uuid "$DEVICE" | grep -sqx "$uuid"; then
        /usr/bin/lua /usr/sbin/baidupan.lua add_disk
        pidof baidupan
        if [ $? -eq 1 ]; then
            /etc/init.d/baidupan start
            logger -p notice -t "hotplug.d" "40-baidupan: start"
        fi
    #fi
    ;;
remove)
    #if ! block info | grep -sqw "\"$uuid\""; then
    blockinfo="$(block info)"
    if [ "$blockinfo" = "" ] ; then
        /etc/init.d/baidupan stop
        logger -p notice -t "hotplug.d" "40-baidupan: stop"
    fi
    ;;
esac

exit 0