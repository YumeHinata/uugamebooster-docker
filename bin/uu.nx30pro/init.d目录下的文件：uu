#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
SERVICE_DAEMONIZE=1
SERVICE_WRITE_PID=1

dirUU="/var/tmp/uu/"
dirPlugmnt="/var/tmp/plugmnt/uu/"

#编辑：更改路径
manufactoryDataFile="/usr/uufactory/factoryinfo"


UUH3cInfoPath="/var/tmp/uu/h3c_info"
uupluginMonitorPath="/var/tmp/uu/h3c_uuplugin_monitor.sh"
uupluginMonitorBinPath="/usr/bin/h3c_uuplugin_monitor.sh"
uupluginLanDevConfiFile="/var/run/landevname.txt"

start_service() {
    procd_open_instance
    #如果开关开启，则拉起进程，如果开关关闭，则不拉进程，直接return返回；
    uu_enable=$(uci get uu.basic.enable)
    if [ 1 -eq $uu_enable ];then
        #创建UU加速所需要的文件目录；
        if [ ! -d "$dirUU" ];then
            mkdir -p $dirUU
            echo "Folder creation succeeded."
        else
            echo "Folder is exit."
        fi

        #创建UU加速所需要的文件目录；
        if [ ! -d "$dirPlugmnt" ];then
            mkdir -p $dirPlugmnt
            echo "Folder creation succeeded."
        else
            echo "Folder is exit."
        fi
        
        #eval $(swinterface IF_GetBridgeIfName 0)
        #编辑：H3C专属命令改为硬编码
        if_acBridgeIfName="br-lan"
        bridge_name=$if_acBridgeIfName
        if [ -n "$bridge_name" ];then
            echo $bridge_name > $uupluginLanDevConfiFile
        else
            rm -rf $uupluginLanDevConfiFile
        fi
        cp $manufactoryDataFile $UUH3cInfoPath
        
        #后台执行脚本
        cp $uupluginMonitorBinPath $uupluginMonitorPath
        sh /var/tmp/uu/h3c_uuplugin_monitor.sh &
    else
        #杀掉脚本进程

        #killall -9 h3c_uuplugin_monitor.sh && {echo "h3c_uuplugin_monitor.sh proc be killed"}
        
        kill -9 $(ps | grep h3c_uuplugin_monitor.sh | grep -v grep | awk '{print $1}')
        
        #kill -9 $(ps | grep uuplugin | grep -v grep | awk '{print $1}')
 
        killall -9 uuplugin
        
        #删除UU加速残留的文件目录；
        rm -rf $dirUU
        rm -rf $dirPlugmnt    
    fi
    
    procd_close_instance
}
